# Xcode
DerivedData/
build/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved
xcuserdata/

# macOS
.DS_Store
*.swp
*~

# Swift Package Manager
.build/
Packages/

# Claude Code — local settings stay out; the skills link is shared, so the
# project's skills (.omp/skills) load in every clone and every worktree.
.claude/*
!.claude/skills

# App secrets — never commit
*.xcconfig
Secrets.swift

# Archives & builds
*.ipa
*.dSYM.zip
*.dSYM
*.app

# Provisioning
*.mobileprovision
*.provisionprofile

# Python bytecode
__pycache__/
*.pyc

# Icon preview contact sheets — regenerate with tools/iconpreview/preview.sh
tools/iconpreview/*.png
