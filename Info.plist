<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Lets the app's own animations run at ProMotion's 120 Hz. Without it an
	     iPhone caps every animation an app drives itself — all of SwiftUI's:
	     a folder opening, the grid making room for a card — at 60, while the
	     scroll views beside them run at 120, and the animations read as choppy
	     next to the scrolling. Anything that runs on its own clock rather than
	     answering a finger asks for 60 by itself (`TimelineSchedule.sixtyHertz`). -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>com.googleusercontent.apps.234191398888-58jmohlpegd1mir5jivla9e579rp6uh7</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
		<!-- Album links travel as https://hollowpoint.tv/a/… — Messages only
		     makes http(s) tappable, so this scheme is NOT the shipping path.
		     It exists so album links can be exercised in the Simulator, where
		     universal links depend on an installed-app AASA fetch that isn't
		     reliable there:

		         xcrun simctl openurl booted "addit://a/g/<folderId>"
		 -->
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>addit</string>
			</array>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
		</dict>
	</array>
	<key>GIDClientID</key>
	<string>234191398888-58jmohlpegd1mir5jivla9e579rp6uh7.apps.googleusercontent.com</string>
	<!-- Addit ships no encryption of its own. It talks HTTPS to Google Drive
	     and Microsoft Graph, which is exempt, so the answer is a flat "no".
	     Without this key App Store Connect stops every single upload to ask
	     the export-compliance question by hand. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Select album cover images from your photo library.</string>
	<!-- Dark only, matching `ThemeService.forcesDark`. SwiftUI's
	     `preferredColorScheme` cannot reach anything drawn before it exists —
	     the launch storyboard most visibly, which was flashing white on a
	     light-mode phone. Keep this in step with that flag: turning light and
	     system back on means removing this key too, or UIKit stays dark while
	     SwiftUI switches. -->
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
	<key>UIAppFonts</key>
	<array>
		<string>DepartureMono-Regular.otf</string>
		<string>Geist-Regular.otf</string>
		<string>Geist-Medium.otf</string>
		<string>Geist-SemiBold.otf</string>
		<string>Geist-Bold.otf</string>
		<string>SpaceGrotesk-Regular.otf</string>
		<string>SpaceGrotesk-Medium.otf</string>
		<string>SpaceGrotesk-Bold.otf</string>
		<string>BDOGrotesk-Regular.otf</string>
		<string>BDOGrotesk-Medium.otf</string>
		<string>BDOGrotesk-DemiBold.otf</string>
		<string>BDOGrotesk-Bold.otf</string>
		<string>Inter-Regular.otf</string>
		<string>Inter-Medium.otf</string>
		<string>Inter-SemiBold.otf</string>
		<string>Inter-Bold.otf</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
